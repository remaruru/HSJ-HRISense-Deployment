# ==============================================================================
# HRISense Monorepo Root Environment Configuration Template
# ==============================================================================
# The backend API reads its configuration from `apps/api/.env`.
# The frontend web app reads configuration from `apps/web/.env` or `apps/web/.env.local`.
#
# Refer to `docs/DEVELOPMENT_SETUP.md` for complete environment setup instructions.
# ==============================================================================

# API configuration (copy to apps/api/.env)
DATABASE_URL="mysql://root:@localhost:3306/hrisense_db"
JWT_SECRET=replace-with-a-long-random-secret
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
PORT=5000
CLIENT_URL=http://localhost:3000

# Web configuration (copy to apps/web/.env)
VITE_API_URL=http://localhost:5000/api/v1
