# ─────────────────────────────────────────────────────────────────────────────
# HRISense API — Environment Configuration Template
#
# Copy this file to `apps/api/.env` and fill in real values for your machine.
# NEVER commit `apps/api/.env`. NEVER put a real secret in this template.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Comma-separated proxy configuration for Express `trust proxy`.
# Leave unset for local development. Behind a reverse proxy set the number of
# hops (e.g. 1) or a specific address so rate limiting sees the real client IP.
# TRUST_PROXY=1

# ── Database — MySQL (XAMPP default: port 3306, user root, empty password) ────
DATABASE_URL="mysql://root:@localhost:3306/hrisense_db"

# Separate database used ONLY for authoring migrations
# (`prisma migrate dev --create-only`). Never point this at hrisense_db.
# SHADOW_DATABASE_URL="mysql://root:@localhost:3306/hrisense_migration_dev_db"

# ── JWT Authentication ───────────────────────────────────────────────────────
# Generate strong unique values, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRES_IN=7d

# Signs the login-free applicant status links. Falls back to JWT_SECRET if unset.
# Rotating this invalidates every previously issued status link.
# APPLICATION_STATUS_TOKEN_SECRET=replace-with-a-long-random-secret

# ── Google Sign-In (optional) ────────────────────────────────────────────────
# Adds "Continue with Google" to the login page for EXISTING accounts only (the
# Google email must equal the account's personal/login email). On when the
# Client ID is set; restart the API after changing it.
#
# Google Cloud → APIs & Services → Credentials → OAuth client (Web application):
#   Authorized JavaScript origins: http://localhost:3000 and http://localhost
#   Authorized redirect URIs:      none (the popup returns to the page itself)
#
# No Client Secret is used: Google's ID token is verified with Google's public
# keys. Never put a Google Client Secret in this repository or a VITE_* variable.
GOOGLE_CLIENT_ID=

# ── reCAPTCHA v2 checkbox (optional) ─────────────────────────────────────────
# google.com/recaptcha/admin → type "Challenge (v2) → I'm not a robot Checkbox",
# domains: localhost, 127.0.0.1 (host names only — no http:// or port). Off until
# both keys are set; restart the API after changing them.
# PUT THE SECRET KEY IN apps/api/.env.local (git-ignored), never in apps/api/.env.
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ── AI Assistance (optional) ─────────────────────────────────────────────────
# The role-aware assistant for HR, supervisors and employees. Adding ONE key for
# the selected provider switches it on. Without a key it reports that AI is
# unavailable; every other feature, and the figures calculated from the
# database, keep working. See docs/HRISENSE_AI_ARCHITECTURE.md.
#
# PUT KEYS IN apps/api/.env.local (git-ignored), NOT in apps/api/.env — .env is
# tracked by git in this repository. .env.local overrides .env.
#
# AI_PROVIDER: openai (default) or anthropic
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional OpenAI-compatible endpoint (e.g. Azure OpenAI or a gateway):
# OPENAI_BASE_URL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=
#
# Optional tuning (defaults shown):
# AI_ENABLED=true               # false switches AI off without removing the key
# AI_MAX_OUTPUT_TOKENS=1500     # longest answer, in tokens
# AI_MAX_TOOL_ROUNDS=6          # data-lookup rounds per question
# AI_REQUEST_TIMEOUT_MS=60000   # per provider call
# AI_HISTORY_MESSAGES=12        # earlier messages sent as conversation context
# AI_RATE_LIMIT_PER_HOUR=60     # questions per user per hour
# AI_TEMPERATURE=               # unset = provider default

# ── Protected file uploads ───────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# ── Transactional email (welcome credentials, password resets) ───────────────
# In development this is OFF unless explicitly set to true, so a developer
# machine cannot email real employees by accident. Set it to true to deliver
# welcome credentials to the employee's personal email address for real.
#
# There is deliberately NO test-redirect setting here. These messages carry
# passwords and reset links, so they are never re-addressed to another mailbox:
# either they reach the employee, or HRISense reports that they were not sent.
ENABLE_TRANSACTIONAL_EMAILS=false
BREVO_API_KEY=
DEFAULT_FROM_NAME=HRISense
# Must be a sender address verified in your Brevo account, or Brevo rejects the send.
DEFAULT_FROM_EMAIL=no-reply@example.org

# ── Recruitment applicant email ──────────────────────────────────────────────
# DEVELOPMENT simulates sends and logs them; BREVO sends for real.
RECRUITMENT_EMAIL_PROVIDER=DEVELOPMENT
RECRUITMENT_EMAIL_SEND_ENABLED=false
RECRUITMENT_EMAIL_TEST_RECIPIENT=
RECRUITMENT_FROM_EMAIL=careers@example.org
RECRUITMENT_FROM_NAME=HRISense Careers
RECRUITMENT_REPLY_TO_EMAIL=

# Automatic applicant emails.
# The application-received acknowledgement is on by default. Status-change and
# interview emails are OFF so HR sends them deliberately, with preview.
RECRUITMENT_AUTO_EMAIL_APPLICATION_RECEIVED=true
RECRUITMENT_AUTO_EMAIL_STATUS_CHANGES=false
RECRUITMENT_AUTO_EMAIL_INTERVIEW_EVENTS=false

# ── Rate limiting ────────────────────────────────────────────────────────────
# Defaults and the full list live in src/config/rate-limits.ts (documented in
# docs/HRISENSE_SYSTEM_REFERENCE.md §4.14). Any category can be overridden:
#   RATE_LIMIT_<CATEGORY>_MAX=…            requests per window
#   RATE_LIMIT_<CATEGORY>_WINDOW_MINUTES=… window length
# Categories: GLOBAL, LOGIN_ACCOUNT, LOGIN_IP, PASSWORD_RECOVERY, REFRESH,
# PASSWORD_CHANGE, AUTHENTICATED_READ, WRITE, SEARCH, UPLOAD, IMPORT, EXPORT,
# REPORT, PUBLIC_READ, PUBLIC_APPLICATION_IP, PUBLIC_APPLICATION_EMAIL.
# Development uses 10× the production numbers. Counters are in memory: correct
# for ONE API server; use a shared store before running several.
# RATE_LIMIT_EXPORT_MAX=20
# RATE_LIMIT_WRITE_MAX=300

# Older names, still honoured for the public careers pages and applications
# (per IP); the per-email application limit is RATE_LIMIT_PUBLIC_APPLICATION_EMAIL_MAX.
PUBLIC_CAREERS_RATE_LIMIT_WINDOW_MINUTES=1
PUBLIC_CAREERS_RATE_LIMIT_MAX=60
PUBLIC_APPLICATION_RATE_LIMIT_WINDOW_MINUTES=60
PUBLIC_APPLICATION_RATE_LIMIT_MAX=20

# ── Holiday calendar suggestions (Nager.Date needs no key) ───────────────────
HOLIDAY_API_KEY=

# ── Demo data (`npm run db:seed:demo`, see prisma/demo/README.md) ───────────
# Password for every demo account (hr@example.com, kitchenstaff@example.com, …).
# Set it in the hosting service's environment settings, never in a committed
# file. At least 8 characters with an uppercase letter, a lowercase letter, a
# number and a special character. Only a bcrypt hash is stored.
DEMO_ACCOUNT_PASSWORD=

# The team's own HR accounts (prisma/demo/team-accounts.js), created by the demo
# seed when this is set: JSON mapping each team email to its password, e.g.
# {"name@tip.edu.ph": "…"}. Set it only in the hosting service's settings.
TEAM_ACCOUNT_PASSWORDS=

# ── Local seeding (development only) ─────────────────────────────────────────
# If unset, `npm run db:seed` generates strong random passwords and prints them
# once. Never seed these accounts into an environment real staff can reach.
SEED_HR_PASSWORD=
SEED_DEFAULT_PASSWORD=
