{
  "name": "@hrisense/api",
  "version": "1.0.0",
  "private": true,
  "description": "HRISense Backend API — Express.js + TypeScript + Prisma",
  "main": "dist/index.js",
  "scripts": {
    "predev": "npm run ai:knowledge",
    "dev": "nodemon -w src -e ts,json --exec tsx src/index.ts",
    "prebuild": "npm run ai:knowledge",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "ai:knowledge": "tsx scripts/ai/build-knowledge.ts",
    "ai:knowledge:check": "tsx scripts/ai/build-knowledge.ts --check",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:create": "cross-env DATABASE_URL=mysql://root@localhost:3306/hrisense_migration_dev_db prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "node prisma/demo/seed-demo.js",
    "db:seed:demo:dry-run": "node prisma/demo/seed-demo.js --dry-run",
    "db:seed:demo:export": "node prisma/demo/export-demo-data.js",
    "db:seed:demo:accounts": "node src/scripts/seed_dev_accounts.js",
    "fix-hierarchy": "tsx src/scripts/fix_org_hierarchy.ts",
    "cleanup-local-dummies": "tsx src/scripts/cleanup_local_dummy_accounts.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "adm-zip": "^0.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.5.1",
    "fast-csv": "^5.0.7",
    "file-type": "^16.5.4",
    "google-auth-library": "10.9.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.3",
    "openai": "^4.67.3",
    "pdfkit": "^0.19.1",
    "uuid": "^10.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.7.5",
    "@types/uuid": "^10.0.0",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14",
    "prisma": "^5.22.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
