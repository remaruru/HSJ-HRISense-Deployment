/// How an evaluation's overall score is reached.
///   CRITERIA       — flat criteria: weighted sum, or plain average (useWeighting)
///   AREA_WEIGHTED  — review areas: each area's average × the area's weight ÷ 100
///   AREA_AVERAGE   — review areas: each area's average, then the average of those
///                    (the Simplified form's own rule: total ÷ 3, then sum ÷ 10)
enum EvaluationScoringMethod {
  CRITERIA
  AREA_WEIGHTED
  AREA_AVERAGE
}

