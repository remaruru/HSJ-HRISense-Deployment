// HRISense — Prisma Schema v2
// Aligned to Job Roles spreadsheet (Hospicio de San Jose)
// Generated: 2026-07-17

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

