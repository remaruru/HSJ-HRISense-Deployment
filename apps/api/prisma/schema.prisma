// ─────────────────────────────────────────────────────────────────────────────
// COMPLIANCE — REQUIREMENTS (Full Implementation)
// ─────────────────────────────────────────────────────────────────────────────

/// HR-defined compliance requirement template.
/// Applicability determined dynamically via ComplianceRequirementScope entries.
model ComplianceRequirement {
  id           String               @id @default(uuid())
  title        String
  description  String?              @db.Text
  category     RequirementCategory
  /// Whether expiry tracking applies for this requirement
  tracksExpiry Boolean              @default(false)
  /// Days before expiry to trigger EXPIRING_SOON status (null = disabled)
  reminderDays Int?
  lifecycle    RequirementLifecycle @default(ACTIVE)
  deletedAt    DateTime?
  createdById  String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  scopes             ComplianceRequirementScope[]
  medicalRecords     MedicalRecord[]
  psychRecords       PsychologicalRecord[]
  complianceRecords  EmployeeComplianceRecord[]
  trainingActivities TrainingActivity[]

  @@index([lifecycle])
  @@index([category])
  @@map("compliance_requirements_new")
}

/// Defines which employees a ComplianceRequirement applies to.
/// Resolved dynamically at query time using current employee organizational data.
model ComplianceRequirementScope {
  id                 String                @id @default(uuid())
  requirementId      String
  requirement        ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  scopeType          RequirementScopeType
  /// Populated when scopeType = UNIT
  targetUnitId       String?
  targetUnit         Unit?                 @relation(fields: [targetUnitId], references: [id])
  /// Populated when scopeType = DEPARTMENT
  targetDepartmentId String?
  targetDepartment   Department?           @relation(fields: [targetDepartmentId], references: [id])
  /// Populated when scopeType = JOB_ROLE
  targetJobRoleId    String?
  targetJobRole      JobRole?              @relation(fields: [targetJobRoleId], references: [id])
  /// Populated when scopeType = EMPLOYEE
  targetEmployeeId   String?
  targetEmployee     Employee?             @relation(fields: [targetEmployeeId], references: [id])
  createdAt          DateTime              @default(now())

  @@index([requirementId])
  @@index([scopeType])
  @@map("compliance_requirement_scopes")
}

