// GENERIC COMPLIANCE RECORDS (Certification / Document / Training / Other)
// ─────────────────────────────────────────────────────────────────────────────

/// Fulfillment record for CERTIFICATION, TRAINING, DOCUMENT, OTHER requirements.
/// Medical and Psychological requirements use their own dedicated record models.
model EmployeeComplianceRecord {
  id              String                @id @default(uuid())
  employeeId      String
  employee        Employee              @relation(fields: [employeeId], references: [id])
  requirementId   String
  requirement     ComplianceRequirement @relation(fields: [requirementId], references: [id])
  /// Human-readable title for this record (e.g. "BLS Certificate 2026")
  recordTitle     String
  /// Optional reference/certificate number
  referenceNumber String?
  /// Date the certificate/document was issued or training was completed
  completedAt     DateTime              @db.Date
  /// Optional validity expiry date as entered by HR from source document
  expiresAt       DateTime?             @db.Date
  notes           String?               @db.Text
  reviewStatus    RecordReviewStatus    @default(PENDING_REVIEW)
  reviewedById    String?
  reviewedAt      DateTime?
  reviewReason    String?               @db.Text
  createdById     String?
  deletedAt       DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  /// SOURCE-EVENT IDEMPOTENCY KEY.
  /// Set when this record was generated automatically by a training completion.
  /// Unique, so retrying the same completion cannot create a second compliance
  /// record. Deliberately NOT a uniqueness rule over (employee, requirement) —
  /// recurring requirements legitimately produce several records over time.
  generatedFromTrainingParticipantId String?              @unique
  generatedFromTrainingParticipant   TrainingParticipant? @relation("ComplianceGeneratedFromTraining", fields: [generatedFromTrainingParticipantId], references: [id])

  documents            EmployeeComplianceDocument[]
  trainingParticipants TrainingParticipant[]        @relation("TrainingParticipantComplianceLink")

  @@index([employeeId])
  @@index([requirementId])
  @@index([reviewStatus])
  @@index([expiresAt])
  @@map("employee_compliance_records")
}

/// Protected document attachment for a generic EmployeeComplianceRecord.
model EmployeeComplianceDocument {
  id                 String                       @id @default(uuid())
  complianceRecordId String
  complianceRecord   EmployeeComplianceRecord     @relation(fields: [complianceRecordId], references: [id], onDelete: Cascade)
  originalFilename   String
  storedFilename     String                       @unique
  mimeType           String
  sizeBytes          Int
  visibility         ComplianceDocumentVisibility @default(VISIBLE)
  notes              String?
  uploadedById       String?
  uploadedAt         DateTime                     @default(now())

  @@index([complianceRecordId])
  @@map("employee_compliance_documents")
}

