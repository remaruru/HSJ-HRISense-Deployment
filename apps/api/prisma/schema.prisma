  generatedComplianceRecord   EmployeeComplianceRecord?   @relation("ComplianceGeneratedFromTraining")
  createdAt                   DateTime                    @default(now())
  updatedAt                   DateTime                    @updatedAt

  @@unique([trainingActivityId, employeeId])
  @@index([trainingActivityId])
  @@index([employeeId])
  @@index([participationStatus])
