// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE IMPORT FOUNDATION
//
// Format-independent. Nothing here encodes any assumption about the Mustard
// Seedtime workbook — its columns, sheets, identifiers and punch semantics are
// still unknown, and the raw layer exists precisely so they do not have to be
// guessed at now.
//
// The pipeline is deliberately three-layered:
//
//   AttendanceImportBatch          one uploaded file / review session
//     └── AttendanceImportRawRow   one VERBATIM source row (evidence)
//           └── AttendanceImportCandidate   one normalized employee-day
//                 └── AttendanceRecord      the real record, written only on
//                                           explicit HR confirmation
//
// Raw rows and candidates are separate models on purpose. If the export turns
// out to carry several biometric punches per employee-day, MANY raw rows must be
// able to normalize into ONE candidate. Collapsing the two layers would make that
// impossible to represent without destroying the original evidence.
// ─────────────────────────────────────────────────────────────────────────────

model AttendanceImportBatch {
  id               String  @id @default(uuid())
  /// SHA-256 of the uploaded file. INDEXED, NOT UNIQUE — the same file may
  /// legitimately be uploaded again after a cancelled or failed import, so a
  /// hash match warns rather than blocks.
  fileHash         String
  originalFilename String
  /// Randomised name under protected storage. Null when file retention is off.
  storedFilename   String? @unique
  fileSizeBytes    Int

  uploadedByUserId String
  uploadedByUser   User     @relation("AttendanceImportUploader", fields: [uploadedByUserId], references: [id])
  uploadedAt       DateTime @default(now())

  status AttendanceImportStatus @default(UPLOADED)

  /// Derived from the parsed rows, never from the filename.
  detectedPeriodStart DateTime? @db.Date
  detectedPeriodEnd   DateTime? @db.Date

  totalSourceRows Int @default(0)

  countNew             Int @default(0)
  countExactDuplicate  Int @default(0)
  countEnrichment      Int @default(0)
  countConflict        Int @default(0)
  countConflictManual  Int @default(0)
  countDuplicateInFile Int @default(0)
  countUnknownEmployee Int @default(0)
  countInvalid         Int @default(0)
  /// Rows whose device code no longer matches the name beside it in the file.
  countIdentityFlagged Int @default(0)

  countApplied Int @default(0)
  countSkipped Int @default(0)
  countFailed  Int @default(0)

  confirmedByUserId String?
  confirmedByUser   User?     @relation("AttendanceImportConfirmer", fields: [confirmedByUserId], references: [id])
  confirmedAt       DateTime?

  completedAt   DateTime?
  failureReason String?   @db.Text

  /// Which normalizer produced the candidates. Lets a later rule correction find
  /// the batches that need re-parsing.
  normalizerVersion String?

  rawRows           AttendanceImportRawRow[]
  candidates        AttendanceImportCandidate[]
  attendanceRecords AttendanceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([uploadedAt])
  @@index([fileHash])
  @@index([detectedPeriodStart, detectedPeriodEnd])
  @@map("attendance_import_batches")
}

model AttendanceImportRawRow {
  id      String                @id @default(uuid())
  batchId String
  batch   AttendanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// 1-based position in the source sheet, so a problem can be reported as
  /// "row 47" in terms the person holding the spreadsheet recognises.
  sourceRowNumber Int
  sourceSheetName String?

  /// The source row exactly as read. NOT interpreted — no column meaning is
  /// assumed anywhere in this model.
  rawPayload Json
  /// Hash of rawPayload, for detecting identical rows within one file.
  rawRowHash String

  /// The normalized employee-day this row contributed to, once a normalizer has
  /// run. Many raw rows may share one candidate (multi-punch formats).
  candidateId String?
  candidate   AttendanceImportCandidate? @relation(fields: [candidateId], references: [id])

  createdAt DateTime @default(now())

  @@unique([batchId, sourceRowNumber])
  @@index([batchId])
  @@index([batchId, rawRowHash])
  @@index([candidateId])
  @@map("attendance_import_raw_rows")
}

model AttendanceImportCandidate {
  id      String                @id @default(uuid())
  batchId String
  batch   AttendanceImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Null when the source identifier matched no employee (UNKNOWN_EMPLOYEE).
  employeeId String?
  employee   Employee? @relation("AttendanceImportCandidateEmployee", fields: [employeeId], references: [id])
  /// The business date this candidate describes. Null only for INVALID rows.
  date       DateTime? @db.Date

  timeIn        DateTime?
  timeOut       DateTime?
  status        AttendanceStatus?
  hoursWorked   Float?
  overtimeHours Float?

  /// The identifier exactly as the file carried it, kept even when it matched
  /// nobody — that is the whole point of the UNKNOWN_EMPLOYEE report.
  sourceEmployeeCode String? @db.VarChar(40)
  /// See AttendanceRecord.sessions / .sourceHours / .reviewFlags.
  sessions           Json?
  sourceHours        Json?
  reviewFlags        Json?

  classification       AttendanceImportClassification @default(INVALID)
  classificationReason String?                        @db.Text

  /// Whether the name printed beside this device code in the file still matches
  /// the employee the code is mapped to.
  ///
  /// The name ITSELF is never stored - only the verdict and how close it was.
  /// Matching remains by `biometricCode` alone; this exists so a device number
  /// quietly reassigned to a different person is caught instead of silently
  /// filing one person's attendance under another's.
  identityVerdict AttendanceImportIdentityVerdict?
  /// 0-100 similarity against the mapped employee. Null when there was nothing
  /// to compare (no name in the file, or the code matched nobody).
  identityScore   Int?

  /// The employee the source name most resembles, offered to HR for one-click
  /// confirmation. An HRISense id, never text copied out of the file. NEVER
  /// applied automatically - a suggestion may raise a question, never settle one.
  suggestedEmployeeId String?
  suggestedEmployee   Employee? @relation("AttendanceImportCandidateSuggested", fields: [suggestedEmployeeId], references: [id])
  suggestedScore      Int?

  /// The record this candidate collides with, when one exists.
  existingRecordId      String?
  existingRecord        AttendanceRecord? @relation(fields: [existingRecordId], references: [id])
  /// The existing values AT CLASSIFICATION TIME. Compared again at apply so a
  /// decision made against a stale preview is never executed.
  existingSnapshot      Json?
  /// `recordVersion` observed at classification time — cheap drift check.
  existingRecordVersion Int?

  hrDecision         AttendanceImportDecision @default(PENDING)
  hrDecisionByUserId String?
  hrDecisionByUser   User?                    @relation("AttendanceImportDecider", fields: [hrDecisionByUserId], references: [id])
  hrDecisionAt       DateTime?
  hrDecisionReason   String?                  @db.Text

  /// Stamped ONLY after the AttendanceRecord write committed. Makes resume after
  /// a partial failure exact rather than a guess.
  appliedAt  DateTime?
  applyError String?   @db.Text

  rawRows AttendanceImportRawRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One candidate per employee-day per batch. Two source rows for the same
  /// employee-day must merge into one candidate, not create a second.
  @@unique([batchId, employeeId, date])
  @@index([batchId, classification])
  @@index([employeeId, date])
  @@index([batchId, hrDecision])
  @@index([batchId, identityVerdict])
  @@map("attendance_import_candidates")
}

/// Lifecycle of one attendance import. Transitions are guarded server-side; the
/// move into APPLYING is conditional so a batch cannot be applied twice.
enum AttendanceImportStatus {
  UPLOADED
  PARSING
  VALIDATED
  APPLYING
  COMPLETED
  PARTIALLY_APPLIED
  CANCELLED
  FAILED
}

/// How one normalized employee-day compares with what HRISense already holds.
enum AttendanceImportClassification {
  NEW
  EXACT_DUPLICATE
  ENRICHMENT
  CONFLICT
  CONFLICT_MANUAL
  DUPLICATE_IN_FILE
  UNKNOWN_EMPLOYEE
  INVALID
}

/// Whether the name beside a device code still matches the employee it maps to.
/// Never used to ASSIGN attendance - only to decide whether to ask HR about it.
enum AttendanceImportIdentityVerdict {
  MATCH
  MISMATCH
  UNCERTAIN
  NO_NAME_IN_SOURCE
  NO_EMPLOYEE_TO_CHECK
}

/// HR's decision for a candidate that cannot be applied automatically.
enum AttendanceImportDecision {
  PENDING
  KEEP_EXISTING
  USE_UPLOADED
  SKIP
}

/// What last wrote an AttendanceRecord.
/// LEGACY is the default for rows that pre-date provenance tracking: their real
/// origin is unknown, and labelling them IMPORT would assert something false.
enum AttendanceRecordSource {
  LEGACY
  IMPORT
  MANUAL
  SYSTEM
}

/// A unit that is expected to work on an organisation calendar entry (holiday,
/// non-working day, suspension). Units not listed observe the entry as usual.
model OrganizationCalendarWorkingUnit {
  id          String                    @id @default(uuid())
  entryId     String
  entry       OrganizationCalendarEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit                      @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdById String?
  createdAt   DateTime                  @default(now())

  @@unique([entryId, unitId])
  @@index([unitId])
  @@map("organization_calendar_working_units")
}
