// ─────────────────────────────────────────────────────────────────────────────
// COMMUNICATION
// ─────────────────────────────────────────────────────────────────────────────

/// Full-lifecycle Announcement model.
/// state + publishAt + expiresAt drive derived user-facing statuses at query time.
/// No cron job required to transition between Draft / Scheduled / Published / Expired.
model Announcement {
  id    String @id @default(uuid())
  title String @db.VarChar(255)

  // ── Legacy field — preserved from original schema. NOT used by new service logic.
  // body TEXT is the authoritative message field, but AnnouncementService still
  // writes the full body into `content` to keep the two in sync — so this is TEXT
  // as well (it was VARCHAR(191), which truncated or rejected longer announcements).
  /// @deprecated Use body instead. Preserved for migration safety.
  content String @db.Text

  /// Authoritative full message body. Populated via: UPDATE announcements SET body = content.
  body String? @db.Text

  priority AnnouncementPriority @default(NORMAL)
  state    AnnouncementState    @default(DRAFT)
  isPinned Boolean              @default(false)

  /// When the announcement becomes visible to recipients.
  /// For DRAFT: null. For SCHEDULED/PUBLISHED: set at activation time.
  publishAt DateTime?

  /// When the announcement is no longer CURRENT (but history is preserved).
  expiresAt DateTime?

  /// Set when HR archives this announcement.
  archivedAt DateTime?

  // ── Legacy fields — preserved from original schema. NOT used by new service logic.
  /// @deprecated Legacy audience enum column. New targeting uses AnnouncementAudienceScope.
  audience         AnnouncementAudience @default(ALL)
  /// @deprecated Legacy unit target. Use AnnouncementAudienceScope instead.
  targetUnitId     String?
  /// @deprecated Legacy job role target. Use AnnouncementAudienceScope instead.
  targetJobRoleId  String?
  /// @deprecated Legacy employee target. Use AnnouncementAudienceScope instead.
  targetEmployeeId String?
  /// @deprecated Legacy author employee FK. Use createdByUserId instead.
  authorId         String?

  /// FK to users.id — the authenticated HR user who created this announcement.
  /// Nullable to allow existing seed rows without a valid User FK.
  createdByUserId String?
  createdBy       User?   @relation("AnnouncementCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  audienceScopes AnnouncementAudienceScope[]
  recipients     AnnouncementRecipient[]
  attachments    AnnouncementAttachment[]

  @@index([state])
  @@index([isPinned])
  @@index([publishAt])
  @@index([expiresAt])
  @@index([createdByUserId])
  @@map("announcements")
}

/// Defines one audience-targeting scope for an Announcement.
/// Multiple scopes are additive — backend resolves and deduplicates.
/// Mirrors the pattern used by ComplianceRequirementScope and EvaluationCycleScope
/// but intentionally separate (Announcements ≠ Compliance domain).
model AnnouncementAudienceScope {
  id             String                @id @default(uuid())
  announcementId String
  announcement   Announcement          @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  scopeType      AnnouncementScopeType

  /// Populated when scopeType = UNIT
  targetUnitId String?
  targetUnit   Unit?   @relation(fields: [targetUnitId], references: [id])

  /// Populated when scopeType = DEPARTMENT
  targetDepartmentId String?
  targetDepartment   Department? @relation(fields: [targetDepartmentId], references: [id])

  /// Populated when scopeType = JOB_ROLE
  targetJobRoleId String?
  targetJobRole   JobRole? @relation(fields: [targetJobRoleId], references: [id])

  /// Populated when scopeType = EMPLOYEE
  targetEmployeeId String?
  targetEmployee   Employee? @relation(fields: [targetEmployeeId], references: [id])

  createdAt DateTime @default(now())

  @@index([announcementId])
  @@index([scopeType])
  @@map("announcement_audience_scopes")
}

/// Recipient snapshot — one row per resolved employee per announcement.
/// Created atomically when an announcement is published or scheduled.
/// NEVER created by employee read actions (read marks only UPDATE existing rows).
model AnnouncementRecipient {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee     @relation(fields: [employeeId], references: [id])

  /// Set when the recipient opens the announcement detail view. Never reset by HR edits.
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@unique([announcementId, employeeId])
  @@index([announcementId])
  @@index([employeeId])
  @@index([readAt])
  @@map("announcement_recipients")
}

/// Protected announcement attachment with secure stored-filename metadata.
/// Mirrors the pattern of MedicalRecordDocument / TrainingActivityDocument.
model AnnouncementAttachment {
  id             String       @id @default(uuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  // ── Legacy fields — preserved from original schema (0 rows, no data at risk).
  /// @deprecated Use originalFilename instead.
  fileName String @db.VarChar(191)
  /// @deprecated Use storedFilename instead. Public URL pattern is insecure.
  fileUrl  String @db.VarChar(191)

  /// Original filename as provided by uploader (display only).
  originalFilename String?

  /// Random server-side filename (crypto.randomBytes). UNIQUE across all attachments.
  storedFilename String? @unique

  /// MIME type validated at upload time.
  mimeType String?

  /// File size in bytes.
  sizeBytes Int?

  /// FK to users.id — HR user who uploaded this attachment.
  uploadedByUserId String?
  uploadedBy       User?   @relation("AttachmentUploader", fields: [uploadedByUserId], references: [id])

  uploadedAt DateTime @default(now())

  @@index([announcementId])
  @@map("announcement_attachments")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  /// Idempotency key for the business event that produced this notification,
  /// e.g. `leave-approved:<leaveRequestId>:<userId>`. Nullable, because plenty of
  /// notifications are one-off and have no natural event key. When present it is
  /// unique, so a retried request cannot create a second copy.
  /// Mirrors the pattern already proven by ApplicantCommunication.eventId.
  eventId   String?          @unique
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

