// ─────────────────────────────────────────────────────────────────────────────
// ORGANIZATION STRUCTURE
// ─────────────────────────────────────────────────────────────────────────────

/// Represents the 7 service units under Hospicio de San Jose
/// (Administrative Services, Finance, General Support Services, Auxiliary Services,
///  Social Services, Pastoral Care/Homelife Services, Health Services)
model Department {
  id                 String   @id @default(uuid())
  name               String   @unique
  code               String   @unique
  description        String?
  isActive           Boolean  @default(true)
  headJobRoleId      String?
  parentDepartmentId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  headJobRole      JobRole?     @relation("DepartmentHeadRole", fields: [headJobRoleId], references: [id])
  parentDepartment Department?  @relation("DepartmentToParent", fields: [parentDepartmentId], references: [id])
  childDepartments Department[] @relation("DepartmentToParent")

  units                 Unit[]
  employees             Employee[]
  jobRoles              JobRole[]
  jobOpenings           JobOpening[]
  complianceScopes      ComplianceRequirementScope[]
  evaluationCycleScopes EvaluationCycleScope[]
  announcementScopes    AnnouncementAudienceScope[]

  @@index([code])
  @@index([parentDepartmentId])
  @@index([headJobRoleId])
  @@map("departments")
}

model Unit {
  id            String      @id @default(uuid())
  name          String      @unique
  code          String      @unique // ADM | FIN | GSS | AUX | SOC | PCH | HLT
  departmentId  String?
  department    Department? @relation(fields: [departmentId], references: [id])
  description   String?
  isActive      Boolean     @default(true)
  headJobRoleId String?
  parentUnitId  String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  headJobRole JobRole? @relation("UnitHeadRole", fields: [headJobRoleId], references: [id])
  parentUnit  Unit?    @relation("UnitToParent", fields: [parentUnitId], references: [id])
  childUnits  Unit[]   @relation("UnitToParent")

  jobRoles              JobRole[]
  employees             Employee[]
  jobOpenings           JobOpening[]
  complianceScopes      ComplianceRequirementScope[]
  evaluationCycleScopes EvaluationCycleScope[]
  announcementScopes    AnnouncementAudienceScope[]
  calendarWorkingDays   OrganizationCalendarWorkingUnit[]

  @@index([code])
  @@index([parentUnitId])
  @@index([headJobRoleId])
  @@map("units")
}

/// All 48 distinct job roles from the Job Roles spreadsheet
/// Each role belongs to one unit and has a permission tier
model JobRole {
  id              String                       @id @default(uuid())
  title           String // Exact title as written in spreadsheet
  code            String                       @unique // Slug: e.g. HR_OFFICER, KITCHEN_SUPERVISOR
  /// The unit the role belongs to. Null for an organisation-wide role that is
  /// not part of one unit (e.g. SISTER); its holders still have their own unit.
  unitId          String?
  unit            Unit?                        @relation(fields: [unitId], references: [id], onDelete: Restrict)
  departmentId    String?
  parentJobRoleId String?
  isHead          Boolean                      @default(false)
  isSupervisor    Boolean                      @default(false)
  hierarchyStatus HierarchyConfigurationStatus @default(PENDING_CONFIRMATION)
  permissionTier  PermissionTier // FULL | SUPERVISOR | STANDARD
  isActive        Boolean                      @default(true)
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt

  department        Department?  @relation(fields: [departmentId], references: [id])
  parentJobRole     JobRole?     @relation("JobRoleToParent", fields: [parentJobRoleId], references: [id])
  childJobRoles     JobRole[]    @relation("JobRoleToParent")
  departmentHeadFor Department[] @relation("DepartmentHeadRole")
  unitHeadFor       Unit[]       @relation("UnitHeadRole")

  employees             Employee[]
  rolePermissions       RolePermission[]
  jobOpenings           JobOpening[]
  complianceScopes      ComplianceRequirementScope[]
  evaluationCycleScopes EvaluationCycleScope[]
  announcementScopes    AnnouncementAudienceScope[]
  evaluationTemplate    EvaluationTemplateJobRole?
  additionalOversights  AdditionalOversight[]

  @@index([unitId])
  @@index([permissionTier])
  @@index([parentJobRoleId])
  @@index([departmentId])
  @@index([hierarchyStatus])
  @@map("job_roles")
}

// ─────────────────────────────────────────────────────────────────────────────
// RBAC — Normalized Permission System
// ─────────────────────────────────────────────────────────────────────────────

/// Granular permission registry
/// Each record represents one specific action on one module with one scope
model Permission {
  id          String @id @default(uuid())
  module      String // employees | leave | attendance | payslip | training | psychological | ai | reports | announcements | compliance | users | audit | settings | profile | activity
  action      String // read | create | update | delete | approve | reject | export | import | manage
  scope       String // OWN | SUBORDINATES | ALL
  description String

  rolePermissions RolePermission[]

  @@unique([module, action, scope])
  @@index([module])
  @@map("permissions")
}

/// Join table linking JobRoles to Permissions
model RolePermission {
  id           String     @id @default(uuid())
  jobRoleId    String
  jobRole      JobRole    @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([jobRoleId, permissionId])
  @@index([jobRoleId])
  @@index([permissionId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUTHENTICATION
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  employeeId          String?   @unique
  employee            Employee? @relation(fields: [employeeId], references: [id])
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  mustChangePassword  Boolean   @default(false)
  deletedAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  sessions                        UserSession[]
  passwordResets                  PasswordResetToken[]
  emailVerifications              EmailVerificationToken[]
  auditLogs                       AuditLog[]               @relation("AuditLogsActor")
  activityLogs                    ActivityLog[]
  supervisorOverrides             Employee[]               @relation("SupervisorOverrideUser")
  notifications                   Notification[]
  sentApplicantCommunications     ApplicantCommunication[]
  scheduleHistoryActions          ScheduleHistoryLog[]     @relation("ScheduleHistoryActor")
  createdAnnouncements            Announcement[]           @relation("AnnouncementCreator")
  uploadedAnnouncementAttachments AnnouncementAttachment[] @relation("AttachmentUploader")

  // Attendance provenance and import back-relations
  attendanceManualEdits      AttendanceRecord[]          @relation("AttendanceManualEditor")
  attendanceImportsUploaded  AttendanceImportBatch[]     @relation("AttendanceImportUploader")
  attendanceImportsConfirmed AttendanceImportBatch[]     @relation("AttendanceImportConfirmer")
  attendanceImportDecisions  AttendanceImportCandidate[] @relation("AttendanceImportDecider")

  // Personal dashboard calendar
  calendarNotes CalendarNote[]

  @@index([email])
  @@map("users")
}

/// Who can see a dashboard calendar note.
enum CalendarNoteAudience {
  PERSONAL // only the author
  ALL // every employee — an HR note for the whole organisation
  SELECTED // only the employees listed in calendar_note_recipients
}

/// A plan, task or notice on the dashboard calendar.
/// PERSONAL notes are private to their author. HR can also post a note to ALL
/// employees or to SELECTED ones; recipients see it read-only. Only the author
/// can change or delete a note. Deleted with the author's account.
model CalendarNote {
  id         String                  @id @default(uuid())
  userId     String
  user       User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       DateTime                @db.Date
  title      String                  @db.VarChar(120)
  details    String?                 @db.Text
  isDone     Boolean                 @default(false)
  audience   CalendarNoteAudience    @default(PERSONAL)
  recipients CalendarNoteRecipient[]
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt

  @@index([userId, date])
  @@index([audience, date])
  @@map("calendar_notes")
}

/// One employee a SELECTED calendar note is addressed to.
model CalendarNoteRecipient {
  id         String       @id @default(uuid())
  noteId     String
  note       CalendarNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([noteId, employeeId])
  @@index([employeeId])
  @@map("calendar_note_recipients")
}

model UserSession {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  //
  // A signed refresh JWT is currently 192 characters and grows with the payload.
  // Prisma's default for an indexed MySQL String is varchar(191), and because
  // this MySQL runs without STRICT_TRANS_TABLES the insert silently TRUNCATED
  // every token to 191 chars — so the lookup by full token never matched and
  // `POST /auth/refresh` always returned 401. 512 leaves generous headroom and
  // still fits InnoDB's 3072-byte DYNAMIC index limit (512 x 4 bytes = 2048).
  refreshToken String   @unique @db.VarChar(512)
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  isRevoked    Boolean  @default(false)
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
  @@index([refreshToken])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
  @@map("email_verification_tokens")
}

// ─────────────────────────────────────────────────────────────────────────────
// EMPLOYEE
// ─────────────────────────────────────────────────────────────────────────────

model Employee {
  id             String      @id @default(uuid())
  employeeNumber String      @unique
  firstName      String
  middleName     String?
  lastName       String
  suffix         String?
  gender         Gender
  dateOfBirth    DateTime    @db.Date
  placeOfBirth   String?
  civilStatus    CivilStatus
  nationality    String      @default("Filipino")
  religion       String?

  // Personal details from the HSJ employee record — all optional. Blank means
  // "not provided" (never a placeholder such as N/A or 0). Age is computed from
  // dateOfBirth and is never stored.
  /// ABO and Rh, e.g. "O+" (one of the eight standard groups).
  bloodType        String? @db.VarChar(3)
  /// Only when civil status is not Single.
  spouseName       String? @db.VarChar(150)
  /// Null = not provided; 0 is a real answer.
  numberOfChildren Int?

  // Contact Information
  /// The employee's email AND their HRISense login address (users.email). One
  /// source: onboarding creates the account with it and HR edits keep the two
  /// in step.
  personalEmail   String?
  /// Legacy — no longer collected or shown. Kept so old values are not lost;
  /// existing accounts that signed in with it still do (see users.email).
  workEmail       String? @unique
  mobilePhone     String
  telephoneNumber String?
  homePhone       String?

  // Address
  presentAddress   String
  /// The home / provincial address ("Provincial Address" on the HSJ record).
  permanentAddress String?

  // Residence within Hospicio — only for employees who live on the premises.
  hsjResidence  String? @db.VarChar(150)
  /// "Unit / Dorm" where they stay. Not the organisational unit (unitId).
  residenceDorm String? @db.VarChar(100)

  // Emergency Contact — mirror of emergency contact #1 (EmployeeEmergencyContact
  // position 1), kept for the screens, exports and tools that read one contact.
  emergencyContactName  String
  emergencyContactRel   String
  emergencyContactPhone String

  // Employment
  departmentId       String?
  department         Department?      @relation(fields: [departmentId], references: [id])
  unitId             String
  unit               Unit             @relation(fields: [unitId], references: [id])
  jobRoleId          String
  jobRole            JobRole          @relation(fields: [jobRoleId], references: [id])
  employmentStatus   EmploymentStatus @default(REGULAR)
  employmentState    EmploymentState  @default(ACTIVE)
  workSchedule       WorkSchedule     @default(REGULAR_DAY_SHIFT)
  hireDate           DateTime         @db.Date
  probationDate      DateTime?        @db.Date
  regularizationDate DateTime?        @db.Date
  separationDate     DateTime?        @db.Date
  separationReason   String?

  // Professional credentials — optional; only licensed professionals have them.
  // An employee counts as "Professional" in the UI when prcLicenseNumber is set.
  prcLicenseNumber String?   @db.VarChar(30)
  professionalRole String?   @db.VarChar(120)
  /// PRC licence dates — only with a licence number. Valid / expiring / expired
  /// is derived from prcValidUntil, never stored.
  prcIssuedDate    DateTime? @db.Date
  prcValidUntil    DateTime? @db.Date

  // TESDA National Certificate (e.g. NC II) — optional; not every role needs one.
  ncCertificateNumber String?   @db.VarChar(50)
  /// The qualification certified, e.g. "Caregiving NC II".
  ncQualification     String?   @db.VarChar(150)
  /// Only when the certificate states a validity.
  ncValidUntil        DateTime? @db.Date

  // Education — as recorded on the HSJ employee record; every part optional.
  primarySchool           String?  @db.VarChar(150)
  secondarySchool         String?  @db.VarChar(150)
  tertiarySchool          String?  @db.VarChar(150)
  tertiaryCourse          String?  @db.VarChar(150)
  /// Graduated from the tertiary course: true / false, or null when not recorded.
  tertiaryGraduated       Boolean?
  diploma                 String?  @db.VarChar(150)
  vocationalQualification String?  @db.VarChar(150)

  // Government IDs
  sssNumber          String?
  philhealthNumber   String?
  pagibigNumber      String?
  tinNumber          String?
  /// Legacy free text ("Label: number" per line), from before other government
  /// IDs became rows (EmployeeGovernmentId). Kept and shown read-only; no longer
  /// written by the app.
  otherGovernmentIds String? @db.Text

  /// HR-managed eligibility for automatic leave entitlement. Never inferred from
  /// sex, civil status, children or any other profile field.
  paternityLeaveEligible  Boolean @default(false)
  soloParentLeaveEligible Boolean @default(false)

  /// The employee's number in the biometric/timekeeping system, as it appears in
  /// the Mustard Seedtime export (the value in parentheses on an employee line).
  /// Unrelated to `employeeNumber`, which is HRISense's own HSJ-XXXX identity.
  /// Unique and nullable: attendance rows are matched on this and NEVER on name.
  biometricCode String? @unique @db.VarChar(40)

  immediateSupervisorId      String?
  supervisorAssignmentSource SupervisorAssignmentSource?
  supervisorAssignmentStatus SupervisorAssignmentStatus?
  supervisorPendingReason    SupervisorPendingReason?
  supervisorOverrideReason   String?
  supervisorOverrideById     String?
  supervisorOverrideAt       DateTime?

  photoUrl  String?
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  user                     User?
  immediateSupervisor      Employee?               @relation("EmployeeSupervisor", fields: [immediateSupervisorId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  directReports            Employee[]              @relation("EmployeeSupervisor")
  supervisorOverrideBy     User?                   @relation("SupervisorOverrideUser", fields: [supervisorOverrideById], references: [id])
  supervisorLinks          SupervisionLink[]       @relation("Supervisor")
  subordinateLinks         SupervisionLink[]       @relation("Subordinate")
  additionalOversights     AdditionalOversight[]   @relation("OversightOverseer")
  additionallyOverseenBy   AdditionalOversight[]   @relation("OversightOverseenEmployee")
  awardNominationsReceived AwardNomination[]       @relation("AwardNominee")
  awardNominationsMade     AwardNomination[]       @relation("AwardNominator")
  awardBallots             AwardBallot[]
  awardVotesReceived       AwardVote[]
  awardResults             AwardResult[]
  hallOfFameRecords        HallOfFameRecord[]
  attendanceRecords        AttendanceRecord[]
  attendanceLogs           AttendanceLog[]
  leaveRequests            LeaveRequest[]          @relation("EmployeeLeaves")
  leaveApprovals           LeaveRequest[]          @relation("ApproverLeaves")
  leaveEndorsements        LeaveRequest[]          @relation("LeaveEndorser")
  leaveRevisionProposals   LeaveRequest[]          @relation("LeaveRevisionProposer")
  leaveBalances            LeaveBalance[]
  evaluationsAsSubject     PerformanceEvaluation[] @relation("EvaluationSubject")
  evaluationsAsEvaluator   PerformanceEvaluation[] @relation("EvaluationEvaluator")
  trainingAttendances      TrainingAttendee[]
  activityAttendances      ActivityAttendance[]

  // Evaluation relations
  evaluationAssignmentsAsSubject   EvaluationAssignment[] @relation("EvaluationAssignmentSubject")
  evaluationAssignmentsAsEvaluator EvaluationAssignment[] @relation("EvaluationAssignmentEvaluator")
  evaluationCyclesDefaultEvaluator EvaluationCycle[]      @relation("CycleDefaultEvaluator")
  evaluationCycleScopes            EvaluationCycleScope[] @relation("EvaluationCycleScopeEmployee")

  // Training relations
  trainingParticipations TrainingParticipant[] @relation("TrainingParticipantEmployee")

  // Legacy health record relations (preserved for schema safety)
  legacyMedicalRecords       LegacyMedicalRecord[]
  legacyPsychologicalRecords LegacyPsychologicalRecord[]

  // New health + compliance record relations
  medicalRecords              MedicalRecord[]
  psychologicalRecords        PsychologicalRecord[]
  complianceRecords           EmployeeComplianceRecord[]
  complianceRequirementScopes ComplianceRequirementScope[]

  payslips                   Payslip[]
  documents                  EmployeeDocument[]
  aiInsightsAbout            AIInsight[]
  announcementAudienceScopes AnnouncementAudienceScope[]
  announcementRecipients     AnnouncementRecipient[]

  scheduleAssignments         EmployeeScheduleAssignment[]
  weeklySchedules             EmployeeWeeklySchedule[]
  attendanceImportCandidates  AttendanceImportCandidate[]  @relation("AttendanceImportCandidateEmployee")
  attendanceImportSuggestions AttendanceImportCandidate[]  @relation("AttendanceImportCandidateSuggested")
  scheduleHistoryTarget       ScheduleHistoryLog[]         @relation("ScheduleHistoryTarget")

  emergencyContacts EmployeeEmergencyContact[]
  governmentIds     EmployeeGovernmentId[]

  // Dashboard calendar notes addressed to this employee
  calendarNoteRecipients CalendarNoteRecipient[]

  @@index([employeeNumber])
  @@index([departmentId])
  @@index([unitId])
  @@index([jobRoleId])
  @@index([employmentStatus])
  @@index([workEmail])
  @@index([immediateSupervisorId])
  @@index([supervisorAssignmentStatus])
  @@index([supervisorAssignmentSource])
  @@map("employees")
}

/// Up to three emergency contacts per employee (position 1-3). Position 1 is
/// required and is mirrored into employees.emergencyContact*.
model EmployeeEmergencyContact {
  id           String   @id @default(uuid())
  employeeId   String
  employee     Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position     Int
  contactName  String
  relationship String
  mobilePhone  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([employeeId, position])
  @@index([employeeId])
  @@map("employee_emergency_contacts")
}

/// Government IDs beyond SSS, PhilHealth, Pag-IBIG and TIN. The type is free
/// text (Passport, UMID, PhilSys ...) — no fixed list.
model EmployeeGovernmentId {
  id         String   @id @default(uuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  position   Int      @default(1)
  idType     String   @db.VarChar(120)
  idNumber   String   @db.VarChar(120)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([employeeId])
  @@map("employee_government_ids")
}

/// Tracks supervisor → subordinate relationships
/// Required for the "UNDER HER SUPERVISION" permission scope in the spreadsheet
// ─── Yearly Achievements ──────────────────────────────────────────────────────
// Hospicio's institutional achievements, one page per year. HR (FULL) creates
// and publishes; every signed-in employee reads the published pages. Not
// related to performance evaluations.

enum YearlyAchievementStatus {
  DRAFT
  PUBLISHED
}

model YearlyAchievementPage {
  id          String                  @id @default(uuid())
  year        Int
  title       String
  summary     String?                 @db.Text
  status      YearlyAchievementStatus @default(DRAFT)
  /// Example content created to show the feature — marked on the page, for HR to edit or delete.
  isSample    Boolean                 @default(false)
  createdById String?
  updatedById String?
  publishedAt DateTime?
  deletedAt   DateTime?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  entries YearlyAchievementEntry[]

  @@index([year])
  @@map("yearly_achievement_pages")
}

model YearlyAchievementEntry {
  id                String                @id @default(uuid())
  pageId            String
  page              YearlyAchievementPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title             String
  description       String                @db.Text
  displayOrder      Int                   @default(1)
  /// Optional image or PDF, stored under uploads/achievements and streamed by an authenticated route.
  attachmentPath    String?
  attachmentName    String?
  attachmentMime    String?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([pageId])
  @@map("yearly_achievement_entries")
}

// ─── Awards & Recognition ─────────────────────────────────────────────────────
// Hospicio's confirmed process: the system identifies who is eligible and tallies
// the votes; people review, verify and declare the final results. Nothing here is
// decided by AI, and evaluation scores play no part.

enum AwardType {
  EMPLOYEE_OF_THE_QUARTER
  VINCENTIAN
  LOUISIAN
  SPECIAL
  LONGEVITY
  CUSTOM
}

/// Not every award uses every stage (Longevity has no nomination or voting).
enum AwardStatus {
  DRAFT
  NOMINATION_OPEN
  NOMINATION_CLOSED
  VOTING_OPEN
  VOTING_CLOSED
  DELIBERATION
  VERIFIED
  FINALIZED
}

/// PER_CATEGORY: each category ranked on its own (Special Awards: Top 5 each).
/// COMBINED: one ranking across the award's categories (Vincentian: Top 15).
enum AwardResultMode {
  PER_CATEGORY
  COMBINED
}

enum AwardResultDecision {
  PENDING
  CONFIRMED
  NOT_AWARDED
}

/// An organisational group for awards: Hospicio's grouping terms ("Admin
/// Services", "Health Services") mapped by HR to CURRENT units, departments,
/// job roles and employees. Never a job role of its own.
model AwardGroup {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String?  @db.Text
  /// One of Hospicio's four Employee of the Quarter / Vincentian groups.
  isOfficial    Boolean  @default(false)
  unitIds       Json
  departmentIds Json
  jobRoleIds    Json
  employeeIds   Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  nomineeCategories AwardCategory[] @relation("AwardCategoryNomineeGroup")
  voterCategories   AwardCategory[] @relation("AwardCategoryVoterGroup")

  @@map("award_groups")
}

/// One award in one period (Employee of the Quarter Q1 2027, Special Awards
/// CY 2027). A new period is a new row, so earlier periods, their titles and
/// their results stay exactly as they were.
model Award {
  id                   String          @id @default(uuid())
  type                 AwardType
  /// Hospicio's official awards; HR-created ones are custom.
  isOfficial           Boolean         @default(false)
  title                String
  description          String?         @db.Text
  year                 Int
  quarter              Int?
  periodLabel          String
  status               AwardStatus     @default(DRAFT)
  usesNomination       Boolean
  usesVoting           Boolean
  requiresConfirmation Boolean         @default(true)
  resultMode           AwardResultMode @default(PER_CATEGORY)
  /// Top N (per category, or overall when COMBINED); null = every nominee with a vote.
  shortlistCount       Int?
  /// Completed years of service are counted as of this date.
  eligibilityDate      DateTime        @db.Date
  /// Nominee rule in completed years (Vincentian: at least 3; Louisian: at most 3).
  minYears             Int?
  maxYears             Int?
  excludeHallOfFame    Boolean         @default(false)
  /// Job roles that cannot be nominees (Employee of the Quarter: leadership).
  excludedJobRoleIds   Json?
  nominationOpenedAt   DateTime?
  nominationClosedAt   DateTime?
  votingOpenedAt       DateTime?
  votingClosedAt       DateTime?
  reviewStartedAt      DateTime?
  verifiedAt           DateTime?
  verifiedById         String?
  finalizedAt          DateTime?
  finalizedById        String?
  createdById          String?
  deletedAt            DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  categories AwardCategory[]
  ballots    AwardBallot[]
  results    AwardResult[]

  @@index([type, year])
  @@index([status])
  @@map("awards")
}

/// A category of an award: an Employee of the Quarter group, a Vincentian group,
/// a Special Award title (editable per period) or a Longevity milestone.
model AwardCategory {
  id             String      @id @default(uuid())
  awardId        String
  award          Award       @relation(fields: [awardId], references: [id], onDelete: Cascade)
  title          String
  description    String?     @db.Text
  displayOrder   Int         @default(1)
  /// Votes each voter may give here, always to DIFFERENT nominees.
  votesPerVoter  Int         @default(1)
  /// Null = organisation-wide.
  nomineeGroupId String?
  nomineeGroup   AwardGroup? @relation("AwardCategoryNomineeGroup", fields: [nomineeGroupId], references: [id], onDelete: Restrict)
  /// Null = every active employee may vote.
  voterGroupId   String?
  voterGroup     AwardGroup? @relation("AwardCategoryVoterGroup", fields: [voterGroupId], references: [id], onDelete: Restrict)
  /// Longevity milestone (5, 10, 15, 20 years).
  milestoneYears Int?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  nominations AwardNomination[]
  votes       AwardVote[]
  results     AwardResult[]

  @@index([awardId])
  @@map("award_categories")
}

model AwardNomination {
  id            String        @id @default(uuid())
  categoryId    String
  category      AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nomineeId     String
  nominee       Employee      @relation("AwardNominee", fields: [nomineeId], references: [id])
  nominatedById String
  nominatedBy   Employee      @relation("AwardNominator", fields: [nominatedById], references: [id])
  reason        String?       @db.Text
  createdAt     DateTime      @default(now())

  @@unique([categoryId, nomineeId, nominatedById])
  @@index([nomineeId])
  @@map("award_nominations")
}

/// One per voter per award, created first in the same transaction as the votes,
/// so a second submission (refresh, another tab, double click) adds no votes.
model AwardBallot {
  id          String      @id @default(uuid())
  awardId     String
  award       Award       @relation(fields: [awardId], references: [id], onDelete: Cascade)
  voterId     String
  voter       Employee    @relation(fields: [voterId], references: [id])
  submittedAt DateTime    @default(now())
  votes       AwardVote[]

  @@unique([awardId, voterId])
  @@map("award_ballots")
}

/// A single vote. Who voted for whom is never returned by the API.
model AwardVote {
  id         String        @id @default(uuid())
  ballotId   String
  ballot     AwardBallot   @relation(fields: [ballotId], references: [id], onDelete: Cascade)
  categoryId String
  category   AwardCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  nomineeId  String
  nominee    Employee      @relation(fields: [nomineeId], references: [id])
  slot       Int

  @@unique([ballotId, categoryId, slot])
  @@unique([ballotId, categoryId, nomineeId])
  @@index([categoryId, nomineeId])
  @@map("award_votes")
}

/// The tally frozen when HR starts the review, and the committee's decisions on it.
model AwardResult {
  id             String              @id @default(uuid())
  awardId        String
  award          Award               @relation(fields: [awardId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       AwardCategory?      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       Employee            @relation(fields: [employeeId], references: [id])
  voteCount      Int                 @default(0)
  rank           Int?
  shortlisted    Boolean             @default(false)
  /// Tied with the last shortlisted place: the committee decides.
  tiedAtCutoff   Boolean             @default(false)
  /// Longevity: completed years when recommended.
  completedYears Int?
  decision       AwardResultDecision @default(PENDING)
  placement      Int?
  note           String?             @db.Text
  decidedById    String?
  decidedAt      DateTime?
  createdAt      DateTime            @default(now())

  @@index([awardId])
  @@index([employeeId])
  @@map("award_results")
}

/// Hall of Fame awardees, recorded by HR as conferred (no formula decides it).
/// They cannot be nominees for the Vincentian, Louisian or Special Awards, but
/// they still vote.
model HallOfFameRecord {
  id           String    @id @default(uuid())
  employeeId   String
  employee     Employee  @relation(fields: [employeeId], references: [id])
  awardYear    Int
  title        String    @default("Hall of Fame Award")
  conferredOn  DateTime? @db.Date
  notes        String?   @db.Text
  recordedById String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([employeeId])
  @@map("hall_of_fame_records")
}

/// Additional (secondary, cross-branch) oversight shown on the Org Chart: an
/// actual employee who also oversees another employee — or everyone currently
/// holding a job role — outside their normal branch. It never changes who the
/// employee reports to (`Employee.immediateSupervisorId` stays the primary
/// hierarchy) and grants NO access by itself: leave, evaluations, attendance,
/// schedules, My Team and every other module keep their own rules.
model AdditionalOversight {
  id                 String    @id @default(uuid())
  overseerId         String
  overseer           Employee  @relation("OversightOverseer", fields: [overseerId], references: [id], onDelete: Cascade)
  /// Exactly one target: one employee, or everyone holding a job role.
  overseenEmployeeId String?
  overseenEmployee   Employee? @relation("OversightOverseenEmployee", fields: [overseenEmployeeId], references: [id], onDelete: Cascade)
  overseenJobRoleId  String?
  overseenJobRole    JobRole?  @relation(fields: [overseenJobRoleId], references: [id], onDelete: Cascade)
  createdById        String?
  createdAt          DateTime  @default(now())

  @@unique([overseerId, overseenEmployeeId])
  @@unique([overseerId, overseenJobRoleId])
  @@index([overseenEmployeeId])
  @@index([overseenJobRoleId])
  @@map("additional_oversights")
}

model SupervisionLink {
  id            String   @id @default(uuid())
  supervisorId  String
  supervisor    Employee @relation("Supervisor", fields: [supervisorId], references: [id])
  subordinateId String
  subordinate   Employee @relation("Subordinate", fields: [subordinateId], references: [id])
  isActive      Boolean  @default(true)
  assignedAt    DateTime @default(now())

  @@unique([supervisorId, subordinateId])
  @@index([supervisorId])
  @@index([subordinateId])
  @@map("supervision_links")
}

// ─────────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

/// Daily attendance summary record per employee
model AttendanceRecord {
  id            String           @id @default(uuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id])
  date          DateTime         @db.Date
  timeIn        DateTime?
  timeOut       DateTime?
  status        AttendanceStatus
  hoursWorked   Float?
  overtimeHours Float?
  remarks       String?
  /// PRE-EXISTING and currently unused by any code path. Its meaning is
  /// "verified", which is NOT the same as "source" — deliberately not repurposed
  /// for provenance. Flagged for a later cleanup decision.
  verifiedById  String?

  // ── Provenance ────────────────────────────────────────────────────────────
  /// Where this record's current values came from. Existing rows default to
  /// LEGACY: their true origin is unknown and claiming IMPORT would be a lie.
  sourceType           AttendanceRecordSource @default(LEGACY)
  /// The import batch that last wrote this record, when one did.
  lastImportBatchId    String?
  lastImportBatch      AttendanceImportBatch? @relation(fields: [lastImportBatchId], references: [id])
  /// Set when HR corrects the record by hand. Non-null means a future import
  /// MUST ask before replacing it — this is the manual-correction guard.
  manuallyModifiedAt   DateTime?
  manuallyModifiedById String?
  manuallyModifiedBy   User?                  @relation("AttendanceManualEditor", fields: [manuallyModifiedById], references: [id])
  /// Incremented on every write. Used for optimistic drift detection between an
  /// import preview and its apply.
  recordVersion        Int                    @default(0)

  // ── Source facts ──────────────────────────────────────────────────────────
  // `timeIn`/`timeOut` stay the first and last punch of the day so every existing
  // reader keeps working. These hold what the export actually said, so nothing is
  // lost when a day has more than one session or the source disagrees with itself.
  /// Every punch pair the source reported: [{ "in": "06:02", "out": "14:27" }, …].
  /// A pair with a missing side keeps the side that exists and nulls the other —
  /// a missing punch is never invented.
  sessions    Json?
  /// The source's own hour columns, verbatim and uncalculated:
  /// { "required": 9, "break": 0, "worked": 6.45, "overtime": 1.97, "undertime": 2.55 }.
  sourceHours Json?
  /// Conditions HR may need to look at for this day — attendance on a scheduled
  /// day off, punches during approved leave, an unclosed punch pair, and so on.
  /// Facts, not verdicts: nothing here changes the status.
  reviewFlags Json?

  logs       AttendanceLog[]
  candidates AttendanceImportCandidate[]
  createdAt  DateTime                    @default(now())
  updatedAt  DateTime                    @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
  @@index([sourceType])
  @@index([lastImportBatchId])
  @@map("attendance_records")
}

/// Granular tardiness/undertime/excuse slip logs
/// Supervisors can view these for their subordinates (per spreadsheet permission)
model AttendanceLog {
  id             String            @id @default(uuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id])
  attendanceId   String?
  attendance     AttendanceRecord? @relation(fields: [attendanceId], references: [id])
  logType        String // LATE | UNDERTIME | EXCUSE_SLIP | OVERTIME | ABSENT_UNEXCUSED
  logDate        DateTime          @db.Date
  minutesLate    Int?
  excuseSlipUrl  String?
  notes          String?
  acknowledgedBy String?
  acknowledgedAt DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId])
  @@index([logDate])
  @@map("attendance_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// LEAVE
// ─────────────────────────────────────────────────────────────────────────────

model LeaveBalance {
  id                        String               @id @default(uuid())
  employeeId                String
  employee                  Employee             @relation(fields: [employeeId], references: [id])
  year                      Int
  leaveType                 LeaveType
  totalAllotted             Float
  used                      Float                @default(0)
  pending                   Float                @default(0)
  forfeited                 Float                @default(0)
  /// AUTOMATIC: totalAllotted follows the completed-years entitlement
  /// (lib/leave-entitlement). MANUAL: HR entered it and HRISense never changes it.
  allotmentSource           LeaveAllotmentSource @default(MANUAL)
  /// Completed years of service the automatic allotment was based on.
  entitlementCompletedYears Int?
  entitlementAppliedAt      DateTime?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([employeeId, year, leaveType])
  @@index([employeeId])
  @@map("leave_balances")
}

model LeaveRequest {
  id               String      @id @default(uuid())
  employeeId       String
  employee         Employee    @relation("EmployeeLeaves", fields: [employeeId], references: [id])
  leaveType        LeaveType
  startDate        DateTime    @db.Date
  endDate          DateTime    @db.Date
  totalDays        Float
  reason           String
  supportingDocUrl String?
  status           LeaveStatus @default(PENDING)
  approvedById     String?
  approvedBy       Employee?   @relation("ApproverLeaves", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  rejectionReason  String?
  hrNotes          String?

  /// Where the employee can be reached during the leave (Hospicio form).
  addressDuringLeave String? @db.VarChar(255)
  /// Contact number during the leave; prefilled from the employee's mobile.
  contactNumber      String? @db.VarChar(40)

  // Head / supervisor recommendation (PENDING → FOR_REVIEW).
  endorsedById    String?
  endorsedBy      Employee? @relation("LeaveEndorser", fields: [endorsedById], references: [id])
  endorsedAt      DateTime?
  endorsementNote String?   @db.Text

  // A change the head proposed while endorsing, for HR's decision. The request
  // itself (startDate / endDate / totalDays) is not touched by a proposal.
  proposedStartDate DateTime? @db.Date
  proposedEndDate   DateTime? @db.Date
  proposedTotalDays Float?
  proposalReason    String?   @db.Text
  proposedById      String?
  proposedBy        Employee? @relation("LeaveRevisionProposer", fields: [proposedById], references: [id])
  proposedAt        DateTime?

  /// Set only when HR approved different dates or days: the employee's ORIGINAL
  /// request. startDate / endDate / totalDays then hold the final approved leave,
  /// which every calendar, attendance and balance figure uses.
  originalStartDate DateTime? @db.Date
  originalEndDate   DateTime? @db.Date
  originalTotalDays Float?
  /// Why the approved leave differs from the request.
  adjustmentReason  String?   @db.Text

  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([employeeId])
  @@index([status])
  @@index([startDate, endDate])
  @@map("leave_requests")
}

// ─────────────────────────────────────────────────────────────────────────────
// PERFORMANCE
// ─────────────────────────────────────────────────────────────────────────────

model PerformanceEvaluation {
  id              String           @id @default(uuid())
  employeeId      String
  employee        Employee         @relation("EvaluationSubject", fields: [employeeId], references: [id])
  evaluatorId     String
  evaluator       Employee         @relation("EvaluationEvaluator", fields: [evaluatorId], references: [id])
  period          String // e.g. "Q1 2026", "Annual 2025"
  year            Int
  quarter         Int? // 1-4, null for annual evaluations
  dimensionScores Json // [{dimension: "Attendance", score: 4.5, weight: 0.20}, ...]
  overallScore    Float
  overallRating   String // Outstanding | Very Satisfactory | Satisfactory | Unsatisfactory | Poor
  comments        String?
  status          EvaluationStatus @default(DRAFT)
  finalizedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([employeeId])
  @@index([year, quarter])
  @@index([status])
  @@map("performance_evaluations")
}

model EvaluationTemplate {
  id             String                  @id @default(uuid())
  name           String
  description    String?                 @db.Text
  ratingMethod   EvaluationRatingMethod  @default(NUMERIC)
  minScore       Float?                  @default(1)
  maxScore       Float?                  @default(5)
  scoreLabels    Json?
  useWeighting   Boolean                 @default(false)
  /// How the overall score is reached (see EvaluationScoringMethod).
  scoringMethod  EvaluationScoringMethod @default(CRITERIA)
  /// Hospicio de San Jose's official forms (seeded from the Word documents HR
  /// supplied). Their content is read-only: HR duplicates one to customise it.
  isOfficial     Boolean                 @default(false)
  officialCode   String?                 @unique
  sourceDocument String?
  /// The form's written sections and wording: instructions, appraisal type
  /// options, comments / goals labels, the employee acknowledgment, and where
  /// the weights came from. Null for templates that predate it.
  formLayout     Json?
  isActive       Boolean                 @default(true)
  createdById    String?
  deletedAt      DateTime?
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  criteria    EvaluationCriterion[]
  groups      EvaluationCriterionGroup[]
  cycles      EvaluationCycle[]
  assignments EvaluationAssignment[]
  jobRoles    EvaluationTemplateJobRole[]

  @@map("evaluation_templates")
}

/// A review area / performance factor. On an area template the area carries the
/// weight; its statements (EvaluationCriterion rows) are the items rated.
model EvaluationCriterionGroup {
  id           String             @id @default(uuid())
  templateId   String
  template     EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  name         String
  description  String?            @db.Text
  displayOrder Int                @default(1)
  weight       Float?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  criteria EvaluationCriterion[]

  @@index([templateId])
  @@map("evaluation_criterion_groups")
}

/// Which template a job role is evaluated with. A role has at most one; a cycle
/// uses it for that role's employees and its own template for everyone else.
model EvaluationTemplateJobRole {
  id         String             @id @default(uuid())
  templateId String
  template   EvaluationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  jobRoleId  String             @unique
  jobRole    JobRole            @relation(fields: [jobRoleId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())

  @@index([templateId])
  @@map("evaluation_template_job_roles")
}

model EvaluationCriterion {
  id                String                    @id @default(uuid())
  templateId        String
  template          EvaluationTemplate        @relation(fields: [templateId], references: [id], onDelete: Cascade)
  /// The review area this statement belongs to (area templates only).
  groupId           String?
  group             EvaluationCriterionGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name              String
  description       String?                   @db.Text
  displayOrder      Int                       @default(1)
  isRatingRequired  Boolean                   @default(true)
  isCommentRequired Boolean                   @default(false)
  weight            Float?
  isActive          Boolean                   @default(true)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([templateId])
  @@index([groupId])
  @@map("evaluation_criteria")
}

model EvaluationCycle {
  id                        String                @id @default(uuid())
  name                      String
  description               String?               @db.Text
  templateId                String
  template                  EvaluationTemplate    @relation(fields: [templateId], references: [id])
  startDate                 DateTime              @db.Date
  dueDate                   DateTime              @db.Date
  status                    EvaluationCycleStatus @default(ACTIVE)
  evaluatorAssignmentMethod String                @default("MANUAL")
  /// The paper form's "Nature of Appraisal" / "Type of Evaluation" for this cycle.
  appraisalType             String?
  /// Chosen when the cycle is created and never changed: its assignments differ.
  evaluationMode            EvaluationMode        @default(STANDARD)
  /// Weighted multi-rater cycles: the self / peer / head percentages the cycle
  /// runs with — Hospicio's 20 / 20 / 60 for every new cycle (older cycles keep
  /// the percentages they were created with). Null for standard cycles.
  selfWeight                Float?
  peerWeight                Float?
  headWeight                Float?
  defaultEvaluatorId        String?
  defaultEvaluator          Employee?             @relation("CycleDefaultEvaluator", fields: [defaultEvaluatorId], references: [id])
  createdById               String?
  deletedAt                 DateTime?
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt

  scopes      EvaluationCycleScope[]
  assignments EvaluationAssignment[]

  @@index([templateId])
  @@index([status])
  @@index([defaultEvaluatorId])
  @@map("evaluation_cycles")
}

model EvaluationCycleScope {
  id                 String               @id @default(uuid())
  cycleId            String
  cycle              EvaluationCycle      @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  scopeType          RequirementScopeType
  targetUnitId       String?
  targetUnit         Unit?                @relation(fields: [targetUnitId], references: [id])
  targetDepartmentId String?
  targetDepartment   Department?          @relation(fields: [targetDepartmentId], references: [id])
  targetJobRoleId    String?
  targetJobRole      JobRole?             @relation(fields: [targetJobRoleId], references: [id])
  targetEmployeeId   String?
  targetEmployee     Employee?            @relation("EvaluationCycleScopeEmployee", fields: [targetEmployeeId], references: [id])
  createdAt          DateTime             @default(now())

  @@index([cycleId])
  @@index([scopeType])
  @@map("evaluation_cycle_scopes")
}

model EvaluationAssignment {
  id                         String                     @id @default(uuid())
  cycleId                    String
  cycle                      EvaluationCycle            @relation(fields: [cycleId], references: [id])
  employeeId                 String
  employee                   Employee                   @relation("EvaluationAssignmentSubject", fields: [employeeId], references: [id])
  evaluatorId                String
  evaluator                  Employee                   @relation("EvaluationAssignmentEvaluator", fields: [evaluatorId], references: [id])
  templateId                 String
  template                   EvaluationTemplate         @relation(fields: [templateId], references: [id])
  templateSnapshot           Json?
  /// Whose rating this is: the employee's SELF rating, a PEER's, or the assigned
  /// HEAD / supervisor / coordinator's. The HEAD assignment carries the
  /// discussion and HR finalisation for the employee's evaluation in the cycle.
  raterType                  EvaluationRaterType        @default(HEAD)
  dueDate                    DateTime                   @db.Date
  status                     EvaluationAssignmentStatus @default(NOT_STARTED)
  startedAt                  DateTime?
  submittedAt                DateTime?
  finalizedAt                DateTime?
  finalizedById              String?
  overallScore               Float?
  overallRating              String?
  evaluatorSummary           String?                    @db.Text
  developmentRecommendations String?                    @db.Text
  isEmployeeVisible          Boolean                    @default(false)
  /// Discussion with the evaluated employee (HEAD assignment only), recorded by
  /// the assigned evaluator after submitting and required before finalisation.
  discussionCompletedAt      DateTime?
  discussionDate             DateTime?                  @db.Date
  discussionNotes            String?                    @db.Text
  discussionRecordedById     String?
  /// Final weighted rating (HEAD row, weighted multi-rater cycles) frozen at HR
  /// finalisation, with the breakdown that produced it.
  combinedScore              Float?
  combinedBreakdown          Json?
  deletedAt                  DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt

  responses EvaluationResponse[]

  @@unique([cycleId, employeeId, raterType, evaluatorId])
  @@index([cycleId])
  @@index([employeeId])
  @@index([evaluatorId])
  @@index([status])
  @@index([templateId])
  @@map("evaluation_assignments")
}

model EvaluationResponse {
  id                   String               @id @default(uuid())
  assignmentId         String
  assignment           EvaluationAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criterionId          String
  criterionName        String
  criterionDescription String?              @db.Text
  criterionWeight      Float?
  ratingNumeric        Float?
  ratingLabel          String?
  comment              String?              @db.Text
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@unique([assignmentId, criterionId])
  @@index([assignmentId])
  @@map("evaluation_responses")
}

