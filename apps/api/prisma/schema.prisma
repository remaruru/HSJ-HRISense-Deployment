model TrainingParticipant {
  id                          String                      @id @default(uuid())
  trainingActivityId          String
  trainingActivity            TrainingActivity            @relation(fields: [trainingActivityId], references: [id], onDelete: Cascade)
  employeeId                  String
  employee                    Employee                    @relation("TrainingParticipantEmployee", fields: [employeeId], references: [id])
  participationStatus         TrainingParticipationStatus @default(ASSIGNED)
  assignedAt                  DateTime                    @default(now())
  completedAt                 DateTime?
  validUntil                  DateTime?                   @db.Date
  notes                       String?                     @db.Text
  certificateOriginalFilename String?
  certificateStoredFilename   String?                     @unique
  certificateMimeType         String?
