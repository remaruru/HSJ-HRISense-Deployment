/// One row per AI request, for auditing. Holds the question, a truncated answer
/// and WHICH tools ran — never tool output, keys, tokens or other secrets.
model AIRequestLog {
  id               String          @id @default(uuid())
  requestedById    String?
  /// The user's question (secret-like strings redacted), or the analysis label.
  prompt           String          @db.Text
  /// The final answer shown to the user, truncated.
  response         String?         @db.Text
  model            String // configurable from env — never hardcoded
  tokensUsed       Int?
  promptTokens     Int?
  completionTokens Int?
  status           AIRequestStatus @default(PENDING)
  durationMs       Int?
  /// Error message only — never request headers or bodies.
  error            String?         @db.Text
  /// ASSISTANT (the role-aware chat) | ANALYSIS (HR's workforce fact-sheet analysis).
  channel          String?         @db.VarChar(20)
  conversationId   String?
  /// Tier resolved on the server for this request. Never taken from the browser.
  actorTier        PermissionTier?
  provider         String?         @db.VarChar(40)
  /// ANSWERED | NO_DATA | NOT_AUTHORIZED | OUT_OF_SCOPE | REFUSED | AI_UNAVAILABLE | ERROR
  outcome          String?         @db.VarChar(30)
  /// Tools the assistant used: [{ name, ok, code?, targetEmployeeId?, rows?, ms }].
  /// Records WHAT was accessed, never the data returned.
  toolCalls        Json?
  toolRounds       Int?
  createdAt        DateTime        @default(now())

  @@index([requestedById])
  @@index([status])
  @@index([createdAt])
  @@index([conversationId])
  @@map("ai_request_logs")
}

/// A user's conversation with the AI assistant. Only the owner can read it.
/// Messages hold the user's text and the assistant's final answer (with any
/// chart it drew) — never raw tool results.
model AIConversation {
  id         String   @id @default(uuid())
  userId     String
  title      String?
  messages   Json // [{ id, role: "user"|"assistant", content, status?, charts?, links?, createdAt }]
  model      String
  isArchived Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([userId, isArchived, updatedAt])
  @@map("ai_conversations")
}

