/// Full lifecycle medical examination record. HR-only access.
/// Sensitive fields (hrNotes) never exposed through compliance or employee-facing endpoints.
model MedicalRecord {
  id            String                 @id @default(uuid())
  employeeId    String
  employee      Employee               @relation(fields: [employeeId], references: [id])
  /// Optional link to the compliance requirement this record fulfills
  requirementId String?
  requirement   ComplianceRequirement? @relation(fields: [requirementId], references: [id])
  /// Type of medical examination
  examType      String // PRE_EMPLOYMENT | ANNUAL | OCCUPATIONAL | SPECIAL
  examDate      DateTime               @db.Date
  examinedBy    String? // Name of physician/clinic
  /// HR-internal administrative notes — NEVER returned to employee view
  hrNotes       String?                @db.Text
  /// Optional expiry date as entered by HR from source document
  expiresAt     DateTime?              @db.Date
  reviewStatus  RecordReviewStatus     @default(PENDING_REVIEW)
  reviewedById  String?
  reviewedAt    DateTime?
  reviewReason  String?                @db.Text
  createdById   String?
  deletedAt     DateTime?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  documents MedicalRecordDocument[]

  @@index([employeeId])
  @@index([requirementId])
  @@index([reviewStatus])
  @@index([examDate])
  @@index([expiresAt])
  @@map("medical_records_new")
}

/// Protected document attachment for a MedicalRecord.
model MedicalRecordDocument {
  id               String        @id @default(uuid())
  medicalRecordId  String
  medicalRecord    MedicalRecord @relation(fields: [medicalRecordId], references: [id], onDelete: Cascade)
  originalFilename String
  storedFilename   String        @unique
  mimeType         String
  sizeBytes        Int
  notes            String?
  uploadedById     String?
  uploadedAt       DateTime      @default(now())

  @@index([medicalRecordId])
  @@map("medical_record_documents")
}

// ─────────────────────────────────────────────────────────────────────────────
// PSYCHOLOGICAL RECORDS (Full Implementation)
// ─────────────────────────────────────────────────────────────────────────────

/// Full lifecycle psychological assessment record.
/// Two structural zones: employee-visible and HR-confidential.
/// Employee self-view ONLY returns employeeVisibleSummary and EMPLOYEE_VISIBLE documents.
model PsychologicalRecord {
  id                     String                 @id @default(uuid())
  employeeId             String
  employee               Employee               @relation(fields: [employeeId], references: [id])
  /// Optional link to the compliance requirement this record fulfills
  requirementId          String?
  requirement            ComplianceRequirement? @relation(fields: [requirementId], references: [id])
  assessmentType         String // PRE_EMPLOYMENT | ANNUAL | COUNSELING | FOLLOW_UP | SPECIAL
  assessmentDate         DateTime               @db.Date
  conductedBy            String? // Name of psychologist/assessor
  /// EMPLOYEE-VISIBLE zone: summary HR chooses to share with the employee
  employeeVisibleSummary String?                @db.Text
  /// HR-CONFIDENTIAL zone: NEVER returned to employee or supervisor views
  hrConfidentialNotes    String?                @db.Text
  /// Optional expiry date as entered by HR from source document
  expiresAt              DateTime?              @db.Date
  reviewStatus           RecordReviewStatus     @default(PENDING_REVIEW)
  reviewedById           String?
  reviewedAt             DateTime?
  reviewReason           String?                @db.Text
  createdById            String?
  deletedAt              DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  documents PsychologicalRecordDocument[]

  @@index([employeeId])
  @@index([requirementId])
  @@index([reviewStatus])
  @@index([assessmentDate])
  @@index([expiresAt])
  @@map("psychological_records_new")
}

/// Protected document for a PsychologicalRecord.
/// visibility field enforced at service layer — HR_ONLY docs never streamed to employee.
model PsychologicalRecordDocument {
  id                    String                          @id @default(uuid())
  psychologicalRecordId String
  psychologicalRecord   PsychologicalRecord             @relation(fields: [psychologicalRecordId], references: [id], onDelete: Cascade)
  originalFilename      String
  storedFilename        String                          @unique
  mimeType              String
  sizeBytes             Int
  /// HR_ONLY documents are never streamed to employee self-view
  visibility            PsychologicalDocumentVisibility @default(HR_ONLY)
  notes                 String?
  uploadedById          String?
  uploadedAt            DateTime                        @default(now())

  @@index([psychologicalRecordId])
  @@index([visibility])
  @@map("psychological_record_documents")
}

